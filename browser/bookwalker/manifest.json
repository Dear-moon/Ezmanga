{
  "manifest_version": 3,
  "name": "Ezmanga BW",
  "version": "1.0.0",
  "minimum_chrome_version": "109",
  "description": "将当前 BookWalker Japan 阅读器的登录态提供给本机 Ezmanga 下载器。",
  "permissions": ["activeTab", "cookies", "scripting"],
  "host_permissions": [
    "https://viewer.bookwalker.jp/*",
    "https://viewer-trial.bookwalker.jp/*",
    "https://viewer-df.bookwalker.jp/*",
    "http://127.0.0.1/*"
  ],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "连接 Ezmanga BW 下载器"}
}
